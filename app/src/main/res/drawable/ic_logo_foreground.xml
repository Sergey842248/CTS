<?xml version="1.0" encoding="utf-8"?>
<!--
  CTS (Circle to Search) launcher icon, adaptive-icon foreground (108dp canvas).

  The mark is a "C"-shaped magnifier: the lens ring is open on the right so it
  reads as a C (for CTS / Circle), a short round-capped handle completes the
  magnifier, and a dot in the lens is the item you circled. The gradient lives
  in ic_logo_background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Open lens ring: 320 degrees, gap facing right (theta -20 .. +20). -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M71.85,60.50 A19,19 0 1 1 71.85,47.50" />
    <!-- Magnifier handle at 50 degrees, tip on the adaptive safe zone. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M66.21,68.55 L73.28,76.98" />
    <!-- The circled target. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,54 m-4,0 a4,4 0,1 0,8,0 a4,4 0,1 0,-8,0" />
</vector>
