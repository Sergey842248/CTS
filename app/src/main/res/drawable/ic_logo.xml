<?xml version="1.0" encoding="utf-8"?>
<!--
  CTS (Circle to Search) logo for in-app use: same crop as the launcher icon —
  the gradient circle fills the drawable and the C-shaped magnifier mark sits on
  top of it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <group android:translateX="-18" android:translateY="-18">
        <!-- Orange-to-pink gradient disc. -->
        <path android:pathData="M54,54m-36,0a36,36 0,1 1,72 0a36,36 0,1 1,-72 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="28.5" android:startY="28.5"
                    android:endX="79.5" android:endY="79.5">
                    <item android:offset="0" android:color="#FFF97316" />
                    <item android:offset="1" android:color="#FFDB2777" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Open lens ring: 320 degrees, gap facing right (theta -20 .. +20). -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M71.85,60.50 A19,19 0 1 1 71.85,47.50" />
        <!-- Magnifier handle at 50 degrees, tip on the adaptive safe zone. -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M66.21,68.55 L73.28,76.98" />
        <!-- The circled target. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M54,54 m-4,0 a4,4 0,1 0,8,0 a4,4 0,1 0,-8,0" />
    </group>
</vector>
